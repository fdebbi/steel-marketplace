msgstr "رد %1$s على طلبك بخصوص «%2$s» بعرض سعر."

#: src/Notifications.php:94
msgid "A provider cannot take your request"
msgstr "مقدم خدمة لا يستطيع تلبية طلبك"

#. translators: 1: provider, 2: service title.
#: src/Notifications.php:96
msgid "%1$s cannot take your request about \"%2$s\". Other providers may."
msgstr "لا يستطيع %1$s تلبية طلبك بخصوص «%2$s». قد يستطيع مقدمو خدمات آخرون."

#: src/Notifications.php:101
msgid "Your quote was accepted"
msgstr "تم قبول عرض سعرك"

#. translators: 1: client, 2: service title.
#: src/Notifications.php:103
msgid ""
"%1$s accepted your quote for \"%2$s\". Contact the client to organise the "
"work."
msgstr "قبل %1$s عرض سعرك لـ«%2$s». تواصل مع العميل لتنظيم الأشغال."

#: src/Notifications.php:108
msgid "Your quote was not accepted"
msgstr "لم يُقبل عرض سعرك"

#. translators: 1: client, 2: service title.
#: src/Notifications.php:110
msgid "%1$s did not accept your quote for \"%2$s\"."
msgstr "لم يقبل %1$s عرض سعرك لـ«%2$s»."

#: src/Notifications.php:115
msgid "A service request was cancelled"
msgstr "تم إلغاء طلب خدمة"

#. translators: 1: client, 2: service title.
#: src/Notifications.php:117
msgid "%1$s cancelled its request about \"%2$s\"."
msgstr "ألغى %1$s طلبه بخصوص «%2$s»."

