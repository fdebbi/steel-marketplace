#: src/Notifications.php:80
msgid "New service request"
msgstr "طلب خدمة جديد"

#. translators: 1: client company, 2: service title.
#: src/Notifications.php:82
msgid ""
"%1$s sent a request about \"%2$s\". Answer with a quote from your dashboard."
msgstr "أرسل %1$s طلبًا بخصوص «%2$s». رد بعرض سعر من لوحة التحكم."

#: src/Notifications.php:87
msgid "You received a quote"
msgstr "تلقيت عرض سعر"

#. translators: 1: provider, 2: service title.
#: src/Notifications.php:89
