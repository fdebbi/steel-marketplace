#. Plugin Name of the plugin
#: sm-core.php
msgid "SM Core"
msgstr "SM Core"

#. Plugin URI of the plugin
#: sm-core.php
msgid "https://github.com/fdebbi/steel-marketplace"
msgstr "https://github.com/fdebbi/steel-marketplace"

#. Description of the plugin
#: sm-core.php
msgid ""
"Central foundation of Steel Marketplace: accounts and companies, business "
"activities, permissions, verification, languages (/ar/), notifications, "
"enquiries, e-mail alerts with editable templates, activity journal, contact "
"form and the sm/v1 REST API. Every other sm-* plugin depends on it."
msgstr ""
"Socle de la plateforme : comptes et entreprises, activités, permissions, "
"vérification, langues (/ar/), notifications, demandes de contact, alertes "
"e-mail avec modèles modifiables, journal d’activité, formulaire de contact "
"et API REST sm/v1. Toutes les autres extensions sm-* en dépendent."

