#. Plugin Name of the plugin
#: sm-core.php
msgid "SM Core"
msgstr "SM Core"

#. Plugin URI of the plugin
#: sm-core.php
msgid "https://github.com/fdebbi/steel-marketplace"
msgstr "https://github.com/fdebbi/steel-marketplace"

#. Description of the plugin
#: sm-core.php
msgid ""
"Central foundation of Steel Marketplace: accounts and companies, business "
"activities, permissions, verification, languages (/ar/), notifications, "
"enquiries, e-mail alerts with editable templates, activity journal, contact "
"form and the sm/v1 REST API. Every other sm-* plugin depends on it."
msgstr ""
"أساس المنصة: الحسابات والمؤسسات، الأنشطة، الصلاحيات، التوثيق، اللغات (/ar/)،"
" الإشعارات، الاستفسارات، تنبيهات البريد الإلكتروني بنماذج قابلة للتعديل، سجل"
" النشاط، نموذج الاتصال وواجهة REST sm/v1. تعتمد عليها كل إضافات sm-* الأخرى."

#. Author of the plugin
#: sm-core.php
