#: src/Spec.php:229
msgid "Give the delivery time in days (0 if in stock today)."
msgstr "Indiquez le délai de livraison en jours (0 si en stock aujourd’hui)."

#: src/Spec.php:236
msgid "Say how many days your price is valid (1 to 180)."
msgstr "Indiquez combien de jours votre prix est valable (1 à 180)."

#: src/Spec.php:243
msgid "The message is too long (3000 characters at most)."
msgstr "Le message est trop long (3000 caractères au maximum)."
