msgid "Choose the type of project."
msgstr "اختر نوع المشروع."

#: src/Form.php:82
msgid "Give a short title, for example “Hangar 20 × 40 m in Sétif”."
msgstr "أعط عنوانا قصيرا، مثلا «هنغار 20 × 40 م في سطيف»."

