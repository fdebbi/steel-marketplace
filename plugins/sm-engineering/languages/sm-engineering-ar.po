#. translators: %s: mission reference and title.
#: src/Notifications.php:158
msgid "The engineer started %s."
msgstr "بدأ المهندس %s."

#: src/Notifications.php:163
msgid "The engineer declined the mission"
msgstr "رفض المهندس المهمة"

#. translators: %s: mission reference and title.
#: src/Notifications.php:165
msgid "The engineer cannot take %s. Choose another engineer."
msgstr "لا يستطيع المهندس أخذ %s. اختر مهندسا آخر."

#. translators: %s: mission reference and title.
#: src/Notifications.php:172
msgid ""
"The engineer sent the deliverables of %s. Check them before delivering them "
"to the client."
msgstr "أرسل المهندس مخرجات %s. راجعها قبل تسليمها للزبون."

#: src/Notifications.php:177
msgid "New message on a mission"
msgstr "رسالة جديدة حول مهمة"

#. translators: 1: client or engineer, 2: mission reference and title.
#: src/Notifications.php:179
msgid "New message from the %1$s on %2$s."
msgstr "رسالة جديدة من %1$s حول %2$s."

#: src/Notifications.php:186
msgid "Your quote for the study is ready"
msgstr "عرض سعر دراستك جاهز"

#. translators: 1: mission reference and title, 2: detail of the quote.
#: src/Notifications.php:188
msgid ""
"The quote for %1$s is ready:\n"
"\n"
"%2$s\n"
"\n"
"Accept or decline it from your account."
msgstr ""
"العرض الخاص بـ %1$s جاهز:\n"
"\n"
"%2$s\n"
"\n"
"اقبله أو ارفضه من حسابك."

#: src/Notifications.php:192
msgid "Your quote ends tomorrow"
msgstr "عرضك ينتهي غدا"

#. translators: 1: mission reference and title, 2: date.
#: src/Notifications.php:194
msgid ""
"The quote for %1$s is valid until %2$s. Accept it or decline it from your "
"account before it ends."
msgstr ""
"العرض الخاص بـ %1$s صالح حتى %2$s. اقبله أو ارفضه من حسابك قبل انتهائه."

#: src/Notifications.php:198
msgid "Complete your payment to start the study"
msgstr "أكمل الدفع لبدء الدراسة"

#. translators: 1: mission reference and title, 2: amount, 3: date.
#: src/Notifications.php:200
msgid ""
"You accepted the quote for %1$s. Pay the advance of %2$s before %3$s to "
"start the requested services; after that date the quote is cancelled."
msgstr ""
"لقد قبلت العرض الخاص بـ %1$s. ادفع التسبيق %2$s قبل %3$s لبدء الخدمات "
"المطلوبة؛ بعد هذا التاريخ يُلغى العرض."

#: src/Notifications.php:204
msgid "Your study request is cancelled"
msgstr "تم إلغاء طلب الدراسة"

#. translators: %s: mission reference and title.
#: src/Notifications.php:206
msgid ""
"The advance for %s was not paid before the end of the quote: the request is "
"cancelled. Send a new request when you are ready."
msgstr ""
"لم يُدفع تسبيق %s قبل نهاية العرض: أُلغي الطلب. أرسل طلبا جديدا عندما تكون "
"جاهزا."

#: src/Notifications.php:210
msgid "Advance received: your study starts"
msgstr "تم استلام التسبيق: تبدأ دراستك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:212
msgid ""
"Your advance for %s is received. The platform appoints a partner engineer; "
"you are told when the study starts."
msgstr ""
"تم استلام تسبيقك لـ %s. تعيّن المنصة مهندسا شريكا ويتم إعلامك عند بدء "
"الدراسة."

#: src/Notifications.php:216
msgid "Your study is ready"
msgstr "دراستك جاهزة"

#. translators: 1: mission reference and title, 2: amount.
#: src/Notifications.php:218
msgid ""
"The documents of %1$s are ready and checked by the platform. Pay the balance"
" of %2$s to download them."
msgstr ""
"وثائق %1$s جاهزة وتحققت منها المنصة. ادفع الرصيد المتبقي %2$s لتحميلها."

#: src/Notifications.php:222
msgid "Payment received: your documents are available"
msgstr "تم استلام الدفع: وثائقك متاحة"

#. translators: %s: mission reference and title.
#: src/Notifications.php:224
msgid ""
"Your payment for %s is received. The documents are available in your account"
" once the study is delivered."
msgstr ""
"تم استلام دفعتك لـ %s. ستكون الوثائق متاحة في حسابك عند تسليم الدراسة."

#: src/Notifications.php:228
msgid "Your study request was not taken"
msgstr "لم يُقبل طلب دراستك"

#. translators: 1: mission reference and title, 2: reason.
#: src/Notifications.php:230
msgid "The platform cannot take %1$s: %2$s"
msgstr "لا يمكن للمنصة قبول %1$s: %2$s"

#: src/Notifications.php:234
msgid "Your study has started"
msgstr "بدأت دراستك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:236
msgid "A partner engineer of the platform is working on %s."
msgstr "مهندس شريك للمنصة يعمل على %s."

#: src/Notifications.php:241
msgid "Your study is delivered"
msgstr "تم تسليم دراستك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:243
msgid "The documents of %s are available in your account."
msgstr "وثائق %s متاحة في حسابك."

#: src/Notifications.php:247
msgid "The platform answered about your study"
msgstr "ردت المنصة حول دراستك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:249 src/Notifications.php:315
msgid "New message about %s."
msgstr "رسالة جديدة حول %s."

#: src/Notifications.php:255
msgid "You are a partner engineer"
msgstr "أنت مهندس شريك"

#: src/Notifications.php:256
msgid ""
"Your application is approved. You appear on the list of partner engineers "
"and the platform can offer you missions."
msgstr ""
"تم قبول ترشحك. تظهر في قائمة المهندسين الشركاء ويمكن للمنصة أن تعرض عليك "
"مهاما."

#: src/Notifications.php:260
msgid "Your application needs changes"
msgstr "ترشحك يحتاج إلى تصحيح"

#. translators: %s: reason.
#: src/Notifications.php:262
msgid ""
"Your partner engineer application was not approved: %s. You can correct it "
"and send it again."
msgstr "لم يُقبل ترشحك كمهندس شريك: %s. يمكنك تصحيحه وإعادة إرساله."

#: src/Notifications.php:266
msgid "Your profile change is approved"
msgstr "تمت الموافقة على تعديل ملفك"

#: src/Notifications.php:267
msgid ""
"The platform approved the change of your partner profile. Your profile is up"
" to date."
msgstr "وافقت المنصة على تعديل ملفك كشريك. ملفك محدّث."

#: src/Notifications.php:271
msgid "Your profile change is refused"
msgstr "تم رفض تعديل ملفك"

#. translators: %s: reason.
#: src/Notifications.php:273
msgid ""
"The platform did not approve the change of your partner profile: %s. Your "
"approved profile stays as it was."
msgstr "لم توافق المنصة على تعديل ملفك كشريك: %s. يبقى ملفك المعتمد كما كان."

#: src/Notifications.php:277
msgid "Your partner account is suspended"
msgstr "حساب الشريك موقوف"

#. translators: %s: reason.
#: src/Notifications.php:279
msgid "You no longer receive missions: %s. Write to the platform for details."
msgstr "لم تعد تتلقى مهاما: %s. راسل المنصة للتفاصيل."

#: src/Notifications.php:283
msgid "A mission is offered to you"
msgstr "عُرضت عليك مهمة"

#. translators: 1: mission reference and title, 2: fee.
#: src/Notifications.php:285
msgid ""
"The platform offers you %1$s. Fee: %2$s. Accept or decline it from your "
"dashboard."
msgstr ""
"تعرض عليك المنصة %1$s. الأتعاب: %2$s. اقبلها أو ارفضها من لوحة التحكم."

#: src/Notifications.php:289
msgid "A mission is no longer assigned to you"
msgstr "لم تعد مهمة مسندة إليك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:291
msgid "The platform withdrew %s from you."
msgstr "سحبت المنصة منك %s."

#: src/Notifications.php:295
msgid "Changes asked on your deliverables"
msgstr "تعديلات مطلوبة على مخرجاتك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:297
msgid "The platform asks for changes on %s. Read the message in the mission."
msgstr "تطلب المنصة تعديلات على %s. اقرأ الرسالة في المهمة."

#: src/Notifications.php:301
msgid "Your deliverables are validated"
msgstr "تم اعتماد مخرجاتك"

#. translators: %s: mission reference and title.
#: src/Notifications.php:303
msgid "The platform validated and delivered %s. Your fee is due."
msgstr "اعتمدت المنصة %s وسلّمتها. أتعابك مستحقة."

#: src/Notifications.php:307
msgid "Your fee is paid"
msgstr "تم دفع أتعابك"

#. translators: 1: amount, 2: mission reference and title.
#: src/Notifications.php:309
msgid "The platform paid your fee of %1$s for %2$s."
msgstr "دفعت المنصة أتعابك بقيمة %1$s عن %2$s."

#: src/Notifications.php:313
msgid "The platform wrote about a mission"
msgstr "كتبت المنصة حول مهمة"

#: src/Payments.php:39
msgid "This study request is not yours."
msgstr "طلب الدراسة هذا ليس لك."

#. translators: 1: percentage, 2: mission reference.
#: src/Payments.php:55
msgid "Advance %1$s %% — engineering study %2$s"
msgstr "تسبيق %1$s %% — دراسة هندسية %2$s"

#. translators: %s: mission reference.
#: src/Payments.php:57
msgid "Balance — engineering study %s"
msgstr "الرصيد المتبقي — دراسة هندسية %s"

#: src/Payments.php:107
msgid ""
"Online payment details are not available yet: the platform contacts you."
msgstr "وسائل الدفع غير متاحة بعد: ستتصل بك المنصة."

